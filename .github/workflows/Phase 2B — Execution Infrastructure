name: Phase 2B - Execution Infrastructure

on:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: phase2-execution
  cancel-in-progress: false

jobs:
  build-execution:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Generate Execution Infrastructure
        run: |
          python - <<'PY'
          from pathlib import Path

          files = {
              "platform_core/contracts/base_worker.py": '''
          from abc import ABC, abstractmethod

          class BaseWorker(ABC):
              name = None
              version = "1.0.0"

              @abstractmethod
              def initialize(self, context):
                  pass

              @abstractmethod
              def execute(self, task):
                  pass

              @abstractmethod
              def health_check(self):
                  pass

              def shutdown(self):
                  pass
          ''',

              "platform_core/plugin_system/worker_registry.py": '''
          import json
          from pathlib import Path

          class WorkerRegistry:
              def __init__(self, worker_directory="plugins/workers"):
                  self.worker_directory = Path(worker_directory)
                  self.workers = {}

              def discover(self):
                  discovered = []

                  if not self.worker_directory.exists():
                      return discovered

                  for manifest in self.worker_directory.rglob("worker.json"):
                      try:
                          data = json.loads(
                              manifest.read_text(encoding="utf-8")
                          )

                          required = ("id", "name", "version", "entry_point")
                          if not all(data.get(key) for key in required):
                              continue

                          worker_id = data["id"]

                          if worker_id in self.workers:
                              continue

                          data["_manifest_path"] = str(manifest)
                          self.workers[worker_id] = data
                          discovered.append(data)

                      except (OSError, json.JSONDecodeError):
                          continue

                  return discovered

              def register(self, worker_id, worker):
                  if worker_id in self.workers:
                      raise ValueError(f"Worker already registered: {worker_id}")

                  self.workers[worker_id] = worker

              def get(self, worker_id):
                  return self.workers.get(worker_id)

              def list_workers(self):
                  return list(self.workers.keys())
          ''',

              "platform_core/plugin_system/worker_manager.py": '''
          class WorkerManager:
              def __init__(self):
                  self.workers = {}
                  self.status = {}

              def register(self, worker_id, worker):
                  if worker_id in self.workers:
                      raise ValueError(f"Worker already exists: {worker_id}")

                  self.workers[worker_id] = worker
                  self.status[worker_id] = "REGISTERED"

              def start(self, worker_id, context=None):
                  worker = self.workers[worker_id]

                  worker.initialize(context or {})
                  self.status[worker_id] = "READY"

                  return self.status[worker_id]

              def execute(self, worker_id, task):
                  worker = self.workers[worker_id]

                  if self.status.get(worker_id) != "READY":
                      raise RuntimeError("Worker is not ready")

                  self.status[worker_id] = "RUNNING"

                  try:
                      result = worker.execute(task)
                      self.status[worker_id] = "READY"
                      return result

                  except Exception:
                      self.status[worker_id] = "ERROR"
                      raise

              def health_check(self, worker_id):
                  worker = self.workers[worker_id]
                  return bool(worker.health_check())

              def stop(self, worker_id):
                  worker = self.workers[worker_id]
                  worker.shutdown()
                  self.status[worker_id] = "STOPPED"
          ''',

              "platform_core/task_queue/task_manager.py": '''
          from uuid import uuid4
          from datetime import datetime, timezone

          class TaskManager:
              def __init__(self):
                  self.tasks = {}

              def create_task(self, task_type, payload=None, priority=5):
                  task_id = str(uuid4())

                  task = {
                      "task_id": task_id,
                      "task_type": task_type,
                      "payload": payload or {},
                      "priority": priority,
                      "status": "PENDING",
                      "created_at": datetime.now(timezone.utc).isoformat()
                  }

                  self.tasks[task_id] = task
                  return task

              def get_task(self, task_id):
                  return self.tasks.get(task_id)

              def update_status(self, task_id, status):
                  if task_id not in self.tasks:
                      raise KeyError(task_id)

                  allowed = {
                      "PENDING", "RUNNING", "SUCCESS", "FAILED"
                  }

                  if status not in allowed:
                      raise ValueError("Invalid task status")

                  self.tasks[task_id]["status"] = status
                  return self.tasks[task_id]

              def list_tasks(self):
                  return list(self.tasks.values())
          ''',

              "platform_core/event_system/__init__.py": "",
              "platform_core/event_system/event_bus.py": '''
          from collections import defaultdict

          class EventBus:
              def __init__(self):
                  self.listeners = defaultdict(list)

              def subscribe(self, event_name, callback):
                  if callback not in self.listeners[event_name]:
                      self.listeners[event_name].append(callback)

              def unsubscribe(self, event_name, callback):
                  if callback in self.listeners[event_name]:
                      self.listeners[event_name].remove(callback)

              def publish(self, event_name, payload=None):
                  results = []

                  for callback in list(self.listeners[event_name]):
                      results.append(callback(payload or {}))

                  return results
          ''',

              "platform_core/architecture_initializer.py": '''
          from platform_core.plugin_system.worker_registry import WorkerRegistry
          from platform_core.plugin_system.worker_manager import WorkerManager
          from platform_core.task_queue.task_manager import TaskManager
          from platform_core.event_system.event_bus import EventBus

          class ArchitectureInitializer:
              def initialize(self):
                  registry = WorkerRegistry()
                  manager = WorkerManager()
                  tasks = TaskManager()
                  events = EventBus()

                  registry.discover()

                  return {
                      "worker_registry": registry,
                      "worker_manager": manager,
                      "task_manager": tasks,
                      "event_bus": events
                  }
          ''',

              "tests/test_phase2_execution.py": '''
          from platform_core.contracts.base_worker import BaseWorker
          from platform_core.plugin_system.worker_registry import WorkerRegistry
          from platform_core.plugin_system.worker_manager import WorkerManager
          from platform_core.task_queue.task_manager import TaskManager
          from platform_core.event_system.event_bus import EventBus
          from platform_core.architecture_initializer import ArchitectureInitializer

          class ExampleWorker(BaseWorker):
              def initialize(self, context):
                  self.ready = True

              def execute(self, task):
                  return {"result": task["value"] * 2}

              def health_check(self):
                  return getattr(self, "ready", False)

          def test_worker_lifecycle():
              manager = WorkerManager()
              worker = ExampleWorker()

              manager.register("example", worker)
              assert manager.start("example") == "READY"
              assert manager.health_check("example") is True

              result = manager.execute("example", {"value": 5})
              assert result["result"] == 10

              manager.stop("example")
              assert manager.status["example"] == "STOPPED"

          def test_task_creation():
              manager = TaskManager()
              task = manager.create_task("example", {"value": 5})

              assert task["status"] == "PENDING"
              assert manager.get_task(task["task_id"]) is not None

          def test_task_status():
              manager = TaskManager()
              task = manager.create_task("example")

              manager.update_status(task["task_id"], "SUCCESS")

              assert manager.get_task(task["task_id"])["status"] == "SUCCESS"

          def test_event_bus():
              bus = EventBus()
              received = []

              bus.subscribe("task.completed", received.append)
              bus.publish("task.completed", {"task_id": "123"})

              assert received == [{"task_id": "123"}]

          def test_worker_registry(tmp_path):
              registry = WorkerRegistry(str(tmp_path))
              assert registry.discover() == []

          def test_architecture_initializer():
              result = ArchitectureInitializer().initialize()

              assert "worker_registry" in result
              assert "worker_manager" in result
              assert "task_manager" in result
              assert "event_bus" in result
          '''
          }

          for filename, content in files.items():
              path = Path(filename)
              path.parent.mkdir(parents=True, exist_ok=True)

              if path.exists():
                  print(f"PRESERVED: {filename}")
              else:
                  path.write_text(content.lstrip(), encoding="utf-8")
                  print(f"CREATED: {filename}")
          PY

      - name: Install Test Dependencies
        run: |
          python -m pip install packaging==25.0 pytest==8.3.5

      - name: Run Execution Infrastructure Tests
        run: |
          python -m pytest tests/test_phase2_execution.py -v

      - name: Commit Execution Infrastructure
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add platform_core/contracts
          git add platform_core/plugin_system
          git add platform_core/task_queue
          git add platform_core/event_system
          git add platform_core/architecture_initializer.py
          git add tests/test_phase2_execution.py

          if git diff --cached --quiet; then
            echo "No changes to commit."
          else
            git commit -m "Build Phase 2B execution infrastructure"
            git push
          fi
